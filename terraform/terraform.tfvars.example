aws_region         = "us-east-2"
availability_zones = ["us-east-2a", "us-east-2b"]

# Prefer your IP/32 for demos. Use 0.0.0.0/0 only if you intentionally want public access.
allowed_app_cidr = "YOUR.PUBLIC.IP.ADDRESS/32"

# Must match the URL browsers use (DuckDNS https URL, or http://PUBLIC_IP:3000).
origin = "https://YOUR_SUBDOMAIN.duckdns.org"
